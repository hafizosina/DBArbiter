# Copy to docker/.env and fill in. docker compose reads docker/.env automatically.
# Postgres applies these only when it first creates a database (an empty volume).
ANTAM_UAT_DB=antam
ANTAM_UAT_USER=antam
ANTAM_UAT_PASSWORD=change-me
ANTAM_PROD_DB=antam
ANTAM_PROD_USER=antam
ANTAM_PROD_PASSWORD=change-me
